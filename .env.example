# Telegram bot token (get from @BotFather)
BOT_TOKEN=

# Telegram user ID of the shop admin (get from @userinfobot)
ADMIN_USER_ID=

# Channel/chat ID where new orders and reviews are forwarded.
# For a public channel use the username with @ prefix (e.g. @vavilonmarketnews).
NEWS_CHANNEL=@vavilonmarketnews

# Crypto Pay API token (get from @CryptoBot -> Crypto Pay -> Create App).
# Leave empty to disable crypto deposits (the UI will say "temporarily unavailable").
CRYPTO_PAY_TOKEN=

# Public URL of the deployed app (used for the Mini App button and CryptoBot webhook).
# When running locally with `python -m app`, leave blank.
PUBLIC_URL=

# Web app port (Fly.io expects 8080)
PORT=8080
